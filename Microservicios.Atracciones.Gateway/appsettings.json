{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/v1/corrales-jorge/attraction/{**remainder}"
        }
      },
      "catalog-base-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/v1/corrales-jorge/attraction"
        }
      },
      "booking-route": {
        "ClusterId": "booking-cluster",
        "Match": {
          "Path": "/api/v1/corrales-jorge/booking/{**remainder}"
        }
      },
      "booking-base-route": {
        "ClusterId": "booking-cluster",
        "Match": {
          "Path": "/api/v1/corrales-jorge/booking"
        }
      },
      "admin-booking-route": {
        "ClusterId": "booking-cluster",
        "Match": {
          "Path": "/api/v1/corrales-jorge/admin-booking/{**remainder}"
        }
      },
      "admin-booking-base-route": {
        "ClusterId": "booking-cluster",
        "Match": {
          "Path": "/api/v1/corrales-jorge/admin-booking"
        }
      },
      "identify-route": {
        "ClusterId": "identify-cluster",
        "Match": {
          "Path": "/api/v1/corrales-jorge/auth/{**remainder}"
        }
      },
      "identify-base-route": {
        "ClusterId": "identify-cluster",
        "Match": {
          "Path": "/api/v1/corrales-jorge/auth"
        }
      },
      "billing-route": {
        "ClusterId": "billing-cluster",
        "Match": {
          "Path": "/api/v1/corrales-jorge/billing/{**remainder}"
        }
      },
      "billing-base-route": {
        "ClusterId": "billing-cluster",
        "Match": {
          "Path": "/api/v1/corrales-jorge/billing"
        }
      },
      "payment-route": {
        "ClusterId": "billing-cluster",
        "Match": {
          "Path": "/api/v1/corrales-jorge/payment/{**remainder}"
        }
      },
      "payment-base-route": {
        "ClusterId": "billing-cluster",
        "Match": {
          "Path": "/api/v1/corrales-jorge/payment"
        }
      }
    },
    "Clusters": {
      "catalog-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://ca-catalog.icycliff-cd7fde0b.eastus2.azurecontainerapps.io"
          }
        }
      },
      "booking-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://ca-booking.icycliff-cd7fde0b.eastus2.azurecontainerapps.io"
          }
        }
      },
      "identify-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://ca-identify.icycliff-cd7fde0b.eastus2.azurecontainerapps.io"
          }
        }
      },
      "billing-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://ca-billing.icycliff-cd7fde0b.eastus2.azurecontainerapps.io"
          }
        }
      }
    }
  }
}
